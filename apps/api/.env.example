# ─── Runtime ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4099
LOG_LEVEL=info        # debug | info | warn | error

# Public URL of the web app (used for verification email redirects etc.
# once the AI / automation tickets land). Omit trailing slash.
APP_URL=http://localhost:3000

# ─── Postgres (Supabase pooler — Transaction mode, port 6543) ──────
# Same value as apps/web's DATABASE_URL. The pgx pool enforces
# `prepare: false` because Supabase's transaction-mode pooler doesn't
# speak prepared statements.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── Supabase Auth (server-only) ───────────────────────────────────
# Both keys are server-only — never expose to the browser. The api
# verifies Supabase JWTs issued by the SAME project apps/web logs
# the user into.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ─── Redis (asynq + locks + dedupe + rate buckets) ─────────────────
# Local dev: docker compose up -d redis (no auth needed locally).
# Prod: include the requirepass via redis://:PASS@127.0.0.1:6379.
#
# Note: whatsmeow's WhatsApp session store is SQLite (data/whatsmeow.db),
# NOT Redis. Redis here is purely for asynq queues + small caches.
REDIS_URL=redis://127.0.0.1:6379

# ─── AI providers ──────────────────────────────────────────────────
# Both optional at boot. Adapters validate at first call, so you only
# need the key for the providers you actually enable per-instance.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Internal service token (TanStack → Go) ────────────────────────
# Shared secret for /v1/internal/* routes. The TanStack web app's
# admin-only server functions forward this in `Authorization: Bearer`
# after their own requirePlatformAdmin() check passes. Must be set
# to the same value on both apps/web (.env) and apps/api (.env).
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# ─── AWS S3 (WhatsApp media — JUR-75/76) ───────────────────────────
# Same bucket + IAM creds the web app uses for attendance / inventory
# / finance / pos uploads. The Go API needs them so the wa:incoming
# worker can upload inbound images and the wa:send_image worker can
# pull operator-attached outbound images.
#
# All four MUST be set together. If any are missing the API still
# boots (logs a warn) but inbound media goes unfetched and the chat
# UI shows "Media tidak tersedia" for every image/sticker/document.
#
# WhatsApp media uses tag `kind=wa-media` and is auto-deleted by
# the bucket's 3-day lifecycle rule (configure in AWS console — JUR-79).
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── WhatsApp send rate limits (token bucket via Redis) ────────────
# Two-level throttle: per-instance (account-wide) + per-JID (recipient).
# Conservative defaults — tighten or loosen only after observing how
# WhatsApp reacts in production. Setting either rate to 0 disables that
# level. MaxWaitMs caps how long a single wa:send task blocks before
# returning rate-limit error and letting asynq retry with its own backoff.
WA_RATE_PER_INSTANCE_PER_SEC=10
WA_RATE_PER_JID_PER_SEC=1
WA_RATE_BUCKET_CAPACITY=5
WA_RATE_MAX_WAIT_MS=5000
