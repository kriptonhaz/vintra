# Supabase (VITE_ prefix exposes to client, non-prefix for server only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Database (Supabase connection pooler URL - Transaction mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# App
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Vintra

# NestJS API (apps/api) — base URL for server-to-server calls.
#   Local dev:  http://localhost:4000
#   ngrok dev:  https://xxxxx.ngrok-free.app   (see docs/wa-dev.md)
#   Prod:       https://api.vintra.my.id      (after JUR-58)
# Web's server functions (src/server/functions/whatsapp.ts) forward
# the user's Supabase JWT to this URL as Authorization: Bearer.
API_URL=http://localhost:4000

# Web Push (VAPID) — generate with `bun run scripts/generate-vapid.ts`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@vintra.my.id
VITE_VAPID_PUBLIC_KEY=

# Brevo transactional email — used for payment / refund receipts.
# Generate at Brevo dashboard → SMTP & API → API Keys.
# When unset, sendEmail() becomes a logged no-op (in-app notification
# still fires, but no email is sent).
BREVO_API_KEY=

# Cloudflare Turnstile — captcha for the public /contact form (JUR-148).
# Sign up at https://dash.cloudflare.com → Turnstile → Add site
# (Widget Mode: Managed). Both vars must be set in production. In dev,
# leaving them empty skips client widget rendering AND server-side
# verification so the form still works without an account.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare cache purge (JUR-177) — purges a tenant's public site
# cache the moment they publish / toggle maintenance, instead of
# waiting out the 5-min edge TTL. API token needs the "Zone → Cache
# Purge" permission for the vintra.my.id zone; Zone ID is on the
# Cloudflare dashboard overview page. When either is unset the purge
# is a logged no-op — publishing still works, edits just take up to
# 5 min to appear.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
